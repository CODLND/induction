rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // No login is used: the game's own collections are open to anyone who
    // has the page. Everything else in the database stays locked.

    // Saved character library
    match /hc_characters/{id} {
      allow read, write: if true;
    }

    // Current game (4 slots, status, reveal switch)
    match /hc_game/{doc} {
      allow read, write: if true;
    }

    // Live progress per team (slots 0-3)
    match /hc_progress/{slot} {
      allow read, write: if slot in ['0', '1', '2', '3'];
    }
  }
}
